<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kiosk Presensi Guru</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.min.js"></script>
  <script src="https://unpkg.com/html5-qrcode"></script>
</head>
<body class="bg-slate-950 text-slate-100 h-screen w-screen overflow-hidden flex flex-col font-sans select-none">

  <!-- Header Kiosk -->
  <header class="h-20 bg-slate-900 border-b border-slate-800 px-8 flex justify-between items-center z-10 shadow-md">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-xl shadow-lg shadow-indigo-500/30">
        P
      </div>
      <div>
        <h1 class="text-xl font-bold tracking-tight text-white leading-none">KIOSK PRESENSI GURU</h1>
        <p class="text-xs text-slate-400 mt-1">Dual-Scanner: Pindai Wajah atau Kartu QR</p>
      </div>
    </div>

    <!-- Jam Digital -->
    <div class="text-right">
      <div id="digitalClock" class="text-3xl font-mono font-extrabold tracking-wider text-indigo-400 leading-none">00:00:00</div>
      <div id="digitalDate" class="text-xs text-slate-400 mt-1 uppercase tracking-wider font-medium">Senin, 1 Januari 2026</div>
    </div>
  </header>

  <!-- Container Utama -->
  <main class="flex-1 flex p-6 gap-6 overflow-hidden">
    
    <!-- Area Kamera & Deteksi -->
    <div class="flex-[3] relative bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-2xl flex items-center justify-center">
      
      <div id="reader" class="w-full h-full object-cover"></div>
      
      <!-- Overlay Canvas untuk Face API Box -->
      <canvas id="faceOverlay" class="absolute inset-0 w-full h-full pointer-events-none z-10"></canvas>

      <!-- Target Pemindai -->
      <div class="absolute inset-0 pointer-events-none flex items-center justify-center z-10">
        <div class="w-80 h-80 border-2 border-indigo-500/30 rounded-3xl relative">
          <div class="absolute -top-1 -left-1 w-6 h-6 border-t-4 border-l-4 border-indigo-500 rounded-tl-lg"></div>
          <div class="absolute -top-1 -right-1 w-6 h-6 border-t-4 border-r-4 border-indigo-500 rounded-tr-lg"></div>
          <div class="absolute -bottom-1 -left-1 w-6 h-6 border-b-4 border-l-4 border-indigo-500 rounded-bl-lg"></div>
          <div class="absolute -bottom-1 -right-1 w-6 h-6 border-b-4 border-r-4 border-indigo-500 rounded-br-lg"></div>
        </div>
      </div>

      <!-- Badge Status Pemindai -->
      <div class="absolute top-4 left-4 z-20 flex space-x-2">
        <span id="badgeScannerStatus" class="px-3 py-1 bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-semibold rounded-full backdrop-blur-md flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Menyiapkan Pemindai...
        </span>
      </div>
    </div>

    <!-- Sidebar Status & Riwayat -->
    <div class="flex-[1.2] flex flex-col gap-6">
      
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg">
        <h2 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-3">Petunjuk Presensi</h2>
        <ul class="text-xs text-slate-400 space-y-2.5">
          <li class="flex items-start gap-2">
            <span class="text-indigo-400 font-bold">1.</span>
            <span>Berdiri tegak menghadap kamera untuk verifikasi wajah otomatis.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-indigo-400 font-bold">2.</span>
            <span>Atau tunjukkan QR Code pada ID Card fisik ke arah kamera.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-indigo-400 font-bold">3.</span>
            <span>Tunggu hingga kartu konfirmasi kehadiran muncul di layar.</span>
          </li>
        </ul>
      </div>

      <div class="flex-1 bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col overflow-hidden">
        <h2 class="text-sm font-semibold text-slate-300 uppercase tracking-wider mb-3">Aktivitas Terkini</h2>
        <div id="localLogList" class="flex-1 overflow-y-auto space-y-2.5 pr-1">
          <div class="text-xs text-slate-600 text-center py-8">Belum ada presensi yang terekam sesi ini.</div>
        </div>
      </div>

    </div>
  </main>

  <!-- MODAL FEEDBACK PRESENSI -->
  <div id="modalFeedback" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-slate-900 border-2 border-indigo-500 rounded-3xl p-8 max-w-sm w-full mx-4 shadow-2xl text-center transform transition-transform scale-95 duration-300" id="modalCard">
      <div id="modalIconContainer" class="w-20 h-20 mx-auto rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-4xl mb-4 font-bold">
        ✓
      </div>
      <span id="modalTipeBadge" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
        PRESENSI MASUK
      </span>
      <h3 id="modalNama" class="text-2xl font-bold text-white mt-3 leading-tight">Nama Guru</h3>
      <p id="modalNip" class="text-sm text-slate-400 font-mono mt-1">NIP: -</p>
      
      <div class="mt-6 pt-4 border-t border-slate-800 flex justify-around">
        <div>
          <span class="text-[10px] text-slate-500 uppercase tracking-wider block">Waktu</span>
          <span id="modalJam" class="text-lg font-mono font-bold text-indigo-400">00:00:00</span>
        </div>
        <div>
          <span class="text-[10px] text-slate-500 uppercase tracking-wider block">Status</span>
          <span id="modalStatus" class="text-lg font-bold text-emerald-400">Tepat Waktu</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbyc93e4j_YOUR_DEPLOYMENT_ID/exec";
    const MODELS_URL = "https://cdn.jsdelivr.net/gh/MAHER1997-C/face-models@main/models";

    let faceMatcher = null;
    let labeledDescriptors = [];
    let isProcessing = false;
    const cooldownMap = new Map();
    const COOLDOWN_MS = 2 * 60 * 1000;

    function initClock() {
      const clockEl = document.getElementById('digitalClock');
      const dateEl = document.getElementById('digitalDate');
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };

      setInterval(() => {
        const now = new Date();
        clockEl.innerText = now.toLocaleTimeString('id-ID', { hour12: false });
        dateEl.innerText = now.toLocaleDateString('id-ID', options);
      }, 1000);
    }

    async function postGAS(payload) {
      const response = await fetch(GAS_API_URL, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(payload)
      });
      return await response.json();
    }

    async function initKiosk() {
      initClock();
      const statusBadge = document.getElementById('badgeScannerStatus');

      try {
        statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Memuat Model AI...`;
        
        await Promise.all([
          faceapi.nets.tinyFaceDetector.loadFromUri(MODELS_URL),
          faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODELS_URL),
          faceapi.nets.faceRecognitionNet.loadFromUri(MODELS_URL)
        ]);

        statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span> Sinkronisasi Database Guru...`;
        await loadTeachersCache();

        statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span> Mengaktifkan Kamera...`;
        await startDualScanner();

        statusBadge.className = "px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-semibold rounded-full backdrop-blur-md flex items-center gap-1.5";
        statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span> Scanner Aktif`;

      } catch (err) {
        console.error(err);
        statusBadge.className = "px-3 py-1 bg-rose-500/20 text-rose-300 border border-rose-500/30 text-xs font-semibold rounded-full backdrop-blur-md flex items-center gap-1.5";
        statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-400"></span> Gagal Memulai`;
      }
    }

    async function loadTeachersCache() {
      const res = await fetch(`${GAS_API_URL}?action=getTeachers`);
      const json = await res.json();

      if (json.success && json.data.length > 0) {
        labeledDescriptors = [];
        json.data.forEach(t => {
          if (t.faceDescriptor && Array.isArray(t.faceDescriptor)) {
            const floatArr = new Float32Array(t.faceDescriptor);
            labeledDescriptors.push(new faceapi.LabeledFaceDescriptors(t.nip, [floatArr]));
          }
        });

        if (labeledDescriptors.length > 0) {
          faceMatcher = new faceapi.FaceMatcher(labeledDescriptors, 0.5);
        }
      }
    }

    async function startDualScanner() {
      const html5QrCode = new Html5Qrcode("reader");

      const qrConfig = {
        fps: 10,
        qrbox: { width: 280, height: 280 },
        aspectRatio: 1.333333
      };

      await html5QrCode.start(
        { facingMode: "user" },
        qrConfig,
        (decodedText) => {
          handleQrCodeScanned(decodedText);
        },
        (errorMessage) => {}
      );

      const videoEl = document.querySelector("#reader video");
      if (videoEl) {
        startFaceDetectionLoop(videoEl);
      }
    }

    function startFaceDetectionLoop(videoEl) {
      const overlayCanvas = document.getElementById('faceOverlay');

      setInterval(async () => {
        if (isProcessing || !faceMatcher || videoEl.paused || videoEl.ended) return;

        overlayCanvas.width = videoEl.videoWidth;
        overlayCanvas.height = videoEl.videoHeight;

        const detection = await faceapi.detectSingleFace(
          videoEl,
          new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.5 })
        ).withFaceLandmarks(true).withFaceDescriptor();

        const ctx = overlayCanvas.getContext('2d');
        ctx.clearRect(0, 0, overlayCanvas.width, overlayCanvas.height);

        if (detection) {
          const dims = faceapi.matchDimensions(overlayCanvas, videoEl, true);
          const resized = faceapi.resizeResults(detection, dims);

          const box = resized.detection.box;
          ctx.strokeStyle = '#6366F1';
          ctx.lineWidth = 3;
          ctx.strokeRect(box.x, box.y, box.width, box.height);

          const match = faceMatcher.findBestMatch(detection.descriptor);
          
          if (match.label !== 'unknown') {
            const detectedNip = match.label;
            triggerAttendance(detectedNip, 'FACE');
          }
        }
      }, 500);
    }

    function handleQrCodeScanned(decodedText) {
      if (isProcessing) return;

      if (decodedText.startsWith("GURU-")) {
        const nip = decodedText.replace("GURU-", "");
        triggerAttendance(nip, 'QR');
      }
    }

    async function triggerAttendance(nip, metode) {
      const now = Date.now();

      if (cooldownMap.has(nip)) {
        const unlockTime = cooldownMap.get(nip);
        if (now < unlockTime) {
          return;
        }
      }

      isProcessing = true;
      cooldownMap.set(nip, now + COOLDOWN_MS);

      try {
        const res = await postGAS({
          action: 'recordAttendance',
          data: { nip: nip, metode: metode }
        });

        if (res.success) {
          showAttendanceModal(res.data);
          appendLocalLog(res.data);
        } else {
          console.warn(res.message);
        }
      } catch (err) {
        console.error("Gagal mencatat presensi:", err);
      } finally {
        setTimeout(() => {
          isProcessing = false;
        }, 1000);
      }
    }

    function showAttendanceModal(data) {
      const modal = document.getElementById('modalFeedback');
      const card = document.getElementById('modalCard');

      document.getElementById('modalNama').innerText = data.nama;
      document.getElementById('modalNip').innerText = "NIP: " + data.nip;
      document.getElementById('modalJam').innerText = data.jam;
      document.getElementById('modalStatus').innerText = data.status;

      const badgeTipe = document.getElementById('modalTipeBadge');
      badgeTipe.innerText = `PRESENSI ${data.tipe.toUpperCase()} (${data.metode})`;

      const statusEl = document.getElementById('modalStatus');
      if (data.status === 'Terlambat') {
        statusEl.className = "text-lg font-bold text-rose-400";
      } else {
        statusEl.className = "text-lg font-bold text-emerald-400";
      }

      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        card.classList.remove('scale-95');
        card.classList.add('scale-100');
      });

      setTimeout(() => {
        modal.classList.add('opacity-0');
        card.classList.remove('scale-100');
        card.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
        }, 300);
      }, 3500);
    }

    function appendLocalLog(data) {
      const list = document.getElementById('localLogList');
      if (list.querySelector('.text-slate-600')) {
        list.innerHTML = '';
      }

      const item = document.createElement('div');
      item.className = "bg-slate-800/80 border border-slate-700/50 p-2.5 rounded-xl flex items-center justify-between text-xs";
      item.innerHTML = `
        <div>
          <div class="font-bold text-slate-200">${data.nama}</div>
          <div class="text-[10px] text-slate-400">${data.jam} • Presensi ${data.tipe} via ${data.metode}</div>
        </div>
        <span class="px-2 py-0.5 rounded font-semibold text-[10px] ${data.status === 'Terlambat' ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'}">
          ${data.status}
        </span>
      `;
      list.prepend(item);
    }

    window.addEventListener('DOMContentLoaded', initKiosk);
  </script>
</body>
</html>
